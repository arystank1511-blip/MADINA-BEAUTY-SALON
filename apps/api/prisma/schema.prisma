generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  CUSTOMER
  ADMIN
  /// The salon's master: «Мой день» only, no prices, staff or settings.
  MASTER
}
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}
model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  email String @unique
  passwordHash String
  role Role @default(CUSTOMER)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  sessions Session[]
  pushSubscriptions PushSubscription[]
  appointments Appointment[] @relation("Customer")
  cancellations Appointment[] @relation("Canceller")
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId String @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model Service {
  id String @id @default(uuid()) @db.Uuid
  category String @default("")
  name String
  description String
  priceMinor Int
  priceFrom Boolean @default(false)
  durationMinutes Int
  bufferAfterMinutes Int
  isActive Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  masters MasterService[]
  appointments Appointment[]
}
model Master {
  id String @id @default(uuid()) @db.Uuid
  name String
  description String
  avatarUrl String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  services MasterService[]
  workingHours WorkingHours[]
  breaks RecurringBreak[]
  timeOffs TimeOff[]
  appointments Appointment[]
}
model MasterService {
  masterId String @db.Uuid
  serviceId String @db.Uuid
  master Master @relation(fields:[masterId],references:[id])
  service Service @relation(fields:[serviceId],references:[id])
  @@id([masterId,serviceId])
  @@index([serviceId])
}
model WorkingHours {
  id String @id @default(uuid()) @db.Uuid
  masterId String @db.Uuid
  weekday Int
  startTime String @db.VarChar(5)
  endTime String @db.VarChar(5)
  master Master @relation(fields:[masterId],references:[id])
  @@unique([masterId,weekday])
}
model RecurringBreak {
  id String @id @default(uuid()) @db.Uuid
  masterId String @db.Uuid
  weekday Int
  startTime String @db.VarChar(5)
  endTime String @db.VarChar(5)
  master Master @relation(fields:[masterId],references:[id])
  @@index([masterId,weekday])
}
model TimeOff {
  id String @id @default(uuid()) @db.Uuid
  masterId String @db.Uuid
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  reason String
  master Master @relation(fields:[masterId],references:[id])
  @@index([masterId,startsAt,endsAt])
}
model Appointment {
  id String @id @default(uuid()) @db.Uuid
  customerId String? @db.Uuid
  guestName String?
  guestPhone String?
  holdUntil DateTime? @db.Timestamptz(3)
  masterId String @db.Uuid
  serviceId String @db.Uuid
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  occupiedUntil DateTime @db.Timestamptz(3)
  status AppointmentStatus @default(CONFIRMED)
  serviceName String
  priceMinor Int
  durationMinutes Int
  bufferAfterMinutes Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  cancelledById String? @db.Uuid
  /// When the salon got the automatic one-hour heads-up in Telegram.
  alertedAt DateTime? @db.Timestamptz(3)
  /// When the client was last sent a WhatsApp reminder from the admin or «Мой день».
  remindedAt DateTime? @db.Timestamptz(3)
  /// When the automatic WhatsApp reminder went out through the WhatsApp Business API.
  waSentAt DateTime? @db.Timestamptz(3)
  /// Why the last automatic WhatsApp reminder failed, as reported by Meta.
  waError String?
  /// When the client was asked for a review after this visit.
  reviewRequestedAt DateTime? @db.Timestamptz(3)
  /// When the client was invited back after this (their latest) visit.
  invitedAt DateTime? @db.Timestamptz(3)
  /// What the client actually paid (prices are «от»), in minor units; null until recorded.
  paidMinor Int?
  /// CASH or KASPI.
  paymentMethod String?
  customer User? @relation("Customer",fields:[customerId],references:[id],onDelete:Restrict)
  cancelledBy User? @relation("Canceller",fields:[cancelledById],references:[id])
  master Master @relation(fields:[masterId],references:[id])
  service Service @relation(fields:[serviceId],references:[id])
  @@index([customerId,startsAt])
  @@index([masterId,startsAt])
  @@index([status,startsAt])
  @@index([guestPhone])
}
/// Salon settings edited in the admin, one JSON document per key (e.g. "whatsapp").
model Setting {
  key String @id
  value Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
/// What the salon knows about a client, keyed by the last 10 digits of their phone.
model Client {
  phone String @id
  note String @default("")
  /// Birthday as MM-DD (no year).
  birthday String?
  /// Site bookings are refused; the client is asked to write in WhatsApp.
  blocked Boolean @default(false)
  /// Year of the last birthday greeting, so it goes out once a year.
  greetedYear Int?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
/// Photos of the salon's work, shown on the site. Stored in the database: the site has no disk.
model Photo {
  id String @id @default(uuid()) @db.Uuid
  data Bytes
  mime String
  caption String @default("")
  width Int
  height Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([createdAt])
}
/// A browser that receives push notifications (the master's phone, the owner's computer).
model PushSubscription {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId])
}
/// «Сообщите, если освободится»: a client waiting for a free time on a full day.
model WaitlistEntry {
  id String @id @default(uuid()) @db.Uuid
  /// Salon date, YYYY-MM-DD.
  date String
  serviceId String? @db.Uuid
  name String
  /// International digits, 7XXXXXXXXXX.
  phone String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  /// When the salon offered a time (the entry leaves the list).
  contactedAt DateTime? @db.Timestamptz(3)
  @@unique([date, phone])
  @@index([date])
}
/// A client review shown on the site; the owner copies them from 2GIS or WhatsApp.
model Review {
  id String @id @default(uuid()) @db.Uuid
  name String
  text String
  rating Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([createdAt])
}
/// A gift certificate sold in the salon; its printable page is /gift/<code>.
model GiftCard {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  amountMinor Int
  recipient String
  sender String @default("")
  phone String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  redeemedAt DateTime? @db.Timestamptz(3)
  @@index([createdAt])
}
/// Money spent by the salon: rent, materials, salary…; profit = revenue − expenses.
model Expense {
  id String @id @default(uuid()) @db.Uuid
  /// Salon date, YYYY-MM-DD.
  date String
  category String
  amountMinor Int
  note String @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([date])
}
/// Salon supplies (dye, shampoo, gloves) with a low-stock threshold.
model Material {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  unit String
  quantity Int
  minQuantity Int
  /// Set when the low-stock alert went out; cleared once restocked above the minimum.
  lowAlertedAt DateTime? @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
