{
  "name": "@forma/api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "tsc && node --watch dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/availability.test.ts test/telegram.test.ts",
    "test:integration": "vitest run test/integration.test.ts --no-file-parallelism",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17",
    "helmet": "8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/web-push": "3.6.4",
    "prisma": "^6.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
