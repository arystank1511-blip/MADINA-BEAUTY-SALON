# Development/demo only. Set strong unique values before hosting.
DATABASE_URL=postgresql://forma:forma_dev@localhost:5432/forma
TEST_DATABASE_URL=postgresql://forma:forma_dev@localhost:5432/forma_test
POSTGRES_PASSWORD=forma_dev
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
DEMO_MODE=true
SALON_NAME=Мадина
SALON_CURRENCY=KZT
SALON_TIMEZONE=Asia/Almaty
SALON_ADDRESS=Адрес салона уточняется
SALON_CONTACT=Контакты салона уточняются
SALON_HOURS=Ежедневно · 10:00–19:00
SALON_WHATSAPP=77767296558
# Telegram notifications about booking requests. Leave empty to disable.
# TELEGRAM_CHAT_ID accepts several ids separated by commas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PORT=3000
# Enable only behind a single trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
