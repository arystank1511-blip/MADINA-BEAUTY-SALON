# Development/demo only. Set strong unique values before hosting.
DATABASE_URL=postgresql://forma:forma_dev@localhost:5432/forma
TEST_DATABASE_URL=postgresql://forma:forma_dev@localhost:5432/forma_test
POSTGRES_PASSWORD=forma_dev
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
DEMO_MODE=true
SALON_NAME=FORMA
SALON_CURRENCY=KZT
SALON_TIMEZONE=Asia/Almaty
SALON_ADDRESS=Демонстрационный салон · Алматы
SALON_CONTACT=hello@forma.example
SALON_HOURS=Ежедневно · 10:00–19:00
PORT=3000
# Enable only behind a single trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
